# Warba Bank — AI-Powered Client Documentation
#
# Copy to `.env` and fill in. PLACEHOLDERS ONLY in this file — never commit a real
# credential (Constitution Principle I, research.md R14).

# --- Database -------------------------------------------------------------
# The application connects as `warba_app`, which holds INSERT+SELECT on audit_event
# and does NOT hold UPDATE/DELETE. See scripts/create_roles.sql.
#
# Port 5434, not 5432: a locally-installed PostgreSQL commonly already holds 5432, and
# connecting to the wrong server surfaces as a confusing "password authentication
# failed" rather than a clear port conflict. See docker-compose.yml.
DATABASE_URL=postgresql+psycopg://warba_app:app_local_only@localhost:5434/warba_docs

# Migrations run as the schema owner, never as the application role.
MIGRATION_DATABASE_URL=postgresql+psycopg://warba_migrate:migrate_local_only@localhost:5434/warba_docs

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_VALUE
JWT_EXPIRY_MINUTES=480

# --- Model ----------------------------------------------------------------
# Leave ANTHROPIC_API_KEY unset if you have run `ant auth login` — a zero-argument
# client resolves the stored profile automatically. Check with `ant auth status`.
ANTHROPIC_API_KEY=
MODEL_ID=claude-opus-5
GENERATION_EFFORT=high

# --- Screening ------------------------------------------------------------
VOCABULARY_VERSION=1.0.0

# --- Uploads --------------------------------------------------------------
MAX_UPLOAD_BYTES=33554432
MAX_UPLOAD_PAGES=600

# --- Environment ----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
